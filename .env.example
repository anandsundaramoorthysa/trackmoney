# ---------------------------------------------------------------------------
# TrackMoney — copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Razorpay — TEST MODE ONLY. Keys starting with rzp_test_.
# A live key (rzp_live_) must never appear in this project.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# No NEXT_PUBLIC_ key is needed: Checkout.js gets the key id back from the
# server alongside the order, so the browser never reads it from the bundle.

# LLM providers. Groq is primary, Gemini is the automatic fallback.
# The app degrades to deterministic templates if both are absent, so it still
# runs (and the demo still works) with neither key set.
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Optional model overrides. The defaults are verified by `npm run check:providers`;
# set these only if your account offers different models.
# GROQ_MODEL="openai/gpt-oss-20b"
# GEMINI_MODEL="gemini-flash-latest"

# Optional. An ECDSA P-256 private key (PKCS#8 PEM, newlines escaped as 
).
# When set, cart mandates are signed and the public half is served at
# /api/agent-commerce/key. When unset, they are returned unsigned and the app
# says so rather than implying a signature that is not there.
MERCHANT_SIGNING_KEY=""
